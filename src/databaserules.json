  },

  "embase": {
    "quote": "'",
    "fields": {
      "[TI]": ":ti",
    "[AB]": ":ab",
    "[TIAB]": ":ti,ab,kw",
    "[TW]": ":tw",
    "[AU]": ":au",
    "[KW]": ":kw",
