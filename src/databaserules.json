    },
    "unsupported_fields": ["[PA]", "[SH]", "[NM]"]  
  },

  "medline": {
    "quote": "\"",
    "fields": {
      "[TI]": ".ti.",
      "[AB]": ".ab.",
      "[TIAB]": ".ti,ab.",
      "[TW]": ".tw.",
      "[PT]": ".pt.",
      "[MAJR]": "*/",
      "[PA]": "/pa"
     
    },
    "mesh": {
      "explode_prefix": "exp",
      "suffix": "/"
    },
    "unsupported_fields": ["[PA]", "[SH]", "[NM]"]  
  }
